# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example
secrets.json

# Generated media files (avoid committing large binary audio/video)
samples/*.mp4
samples/*.wav
*.mp4
*.wav
*.mp3
*.mkv

# Temporary files, caches, and large databases
*.log
temp/
tmp/
data/cache/
data/*.db
data/*.sqlite

# IDE / Editor / OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
